//@version=5
indicator(title='all new KBGv3', shorttitle='all new KBGv3', overlay=true)

// Inputs
showZigZags = input.bool(false)
useAltTF1 = input.bool(false, title='Use Alt Timeframe')
tf1 = input.timeframe('60', title='Alt Timeframe')
tf2 = input.timeframe('240', title='Alt Timeframe')
tf3 = input.timeframe('480', title='Alt Timeframe')

// ─── 리페인트 수정 핵심 ───────────────────────────────────────────────────────
// 기존: 함수 안에서 request.security 반환 (중첩 호출) + lookahead_on → 리페인트
// 수정: 함수는 순수 계산만 담당, 단일 security 호출에서 [1] + lookahead_off 사용
// ─────────────────────────────────────────────────────────────────────────────

// Zigzag function (non-repainting: 순수 계산만, security 호출 없음)
zigzag() =>
    var float _direction = na
    _isUp   = close >= open
    _isDown = close <= open
    _direction := _isUp[1] and _isDown ? -1 : _isDown[1] and _isUp ? 1 : nz(_direction[1])
    _isUp[1] and _isDown and _direction[1] != -1 ? high :
     _isDown[1] and _isUp and _direction[1] != 1  ? low  : na

// 확정 봉 기준: expression[1] + lookahead_off → 완전 논리페인트
zz3 = request.security(syminfo.tickerid, tf3, zigzag()[1], lookahead=barmerge.lookahead_off)

// Plot ZigZag
plot(not showZigZags ? na : zz3, title='zigzag3', color=color.red, linewidth=3)

// Identify ZigZag levels
var float lastZigzag = na
is_lvl3_high = (not na(zz3) and zz3 >= high and zz3 != lastZigzag)
is_lvl3_low  = (not na(zz3) and zz3 <= low  and zz3 != lastZigzag)
if (not na(zz3) and zz3 != lastZigzag)
    lastZigzag := zz3

plotshape(is_lvl3_high, color=color.red,  text="S", location=location.abovebar)
plotshape(is_lvl3_low,  color=color.blue, text="L", location=location.belowbar)

// Alerts
if (is_lvl3_high)
    alert("S", alert.freq_once_per_bar_close)
if (is_lvl3_low)
    alert("L", alert.freq_once_per_bar_close)

// KBG MA Settings
show_hma        = input.bool(true,  title="Display KBG MA Set:")
hma_src         = input.source(close, title="KBG MA's Source:")
hma_base_length = input.int(8, minval=1, title="KBG MA's Base Length:")
hma_length_scalar = input.int(5, minval=0, title="KBG MA's Length Scalar:")

// Hull Moving Average function
hullma(src, length) =>
    ta.wma(2 * ta.wma(src, length / 2) - ta.wma(src, length), math.round(math.sqrt(length)))

// Plot Hull MA
plot(not show_hma ? na : hullma(hma_src, hma_base_length + hma_length_scalar * 6),
     color=color.lime, linewidth=3, title="KBG MA")

// KBG MA Trend
len1 = input.int(5)
len3 = input.int(240)
src  = close
ma1  = ta.wma(2 * ta.wma(src, len1 / 2) - ta.wma(src, len1), math.round(math.sqrt(len1)))
ma   = ta.wma(2 * ta.wma(src, len3 / 2) - ta.wma(src, len3), math.round(math.sqrt(len3)))
atr_range = ta.tr(true)
rangema   = ta.wma(2 * ta.wma(atr_range, len3 / 2) - ta.wma(atr_range, len3), math.round(math.sqrt(len3)))
upper2 = ma + rangema * 0.5
lower2 = ma - rangema * 0.5

// Trend Definition
tr_up   = ma1 > upper2
tr_down = ma1 < lower2
scolor  = tr_up ? color.green : tr_down ? color.red : color.blue
bgcolor(scolor)

// ─── 트렌드 상태 (색상 변화 → 진입 시그널) ───────────────────────────────────
trend_state = tr_up ? 1 : tr_down ? -1 : 0
prev_state  = tr_up[1] ? 1 : tr_down[1] ? -1 : 0
color_changed = trend_state != prev_state
trend_to_long  = color_changed and trend_state ==  1 and barstate.isconfirmed
trend_to_short = color_changed and trend_state == -1 and barstate.isconfirmed
trend_to_neutral = color_changed and trend_state == 0 and barstate.isconfirmed

// 색상 변화 진입 시그널 표시
plotshape(trend_to_long, title="Color → Long", text="LONG", style=shape.labelup,
     location=location.belowbar, color=color.lime, textcolor=color.white, size=size.small)
plotshape(trend_to_short, title="Color → Short", text="SHORT", style=shape.labeldown,
     location=location.abovebar, color=color.maroon, textcolor=color.white, size=size.small)

// 색상 변화 알림
if trend_to_long
    alert("COLOR → LONG", alert.freq_once_per_bar_close)
if trend_to_short
    alert("COLOR → SHORT", alert.freq_once_per_bar_close)

// ─── TP 반전 시그널 (Swing Reverse Signals) ─────────────────────────────────
// 고점 감지 → 롱 청산 + 숏 진입 / 저점 감지 → 숏 청산 + 롱 진입
// 3가지 조합: ① Pivot High/Low ② RSI 과매수/과매도 ③ HMA 기울기 반전

// Settings
exit_pivot_left  = input.int(3, minval=1, title="Pivot Left Bars",  group="TP Reverse")
exit_pivot_right = input.int(3, minval=1, title="Pivot Right Bars", group="TP Reverse")
exit_rsi_len     = input.int(14, minval=1, title="RSI Length",      group="TP Reverse")
exit_rsi_ob      = input.int(70, minval=50, maxval=95, title="RSI Overbought", group="TP Reverse")
exit_rsi_os      = input.int(30, minval=5,  maxval=50, title="RSI Oversold",   group="TP Reverse")
exit_min_score   = input.int(2, minval=1, maxval=3, title="Min Signals (1-3)", group="TP Reverse")

// ─── 횡보 필터 (Bollinger Band Width) ────────────────────────────────────────
// BB 폭이 평균보다 넓으면 = 변동성 있음 = 추세 → 시그널 허용
// BB 폭이 평균보다 좁으면 = 스퀴즈 = 횡보 → 시그널 차단
bbw_len     = input.int(20, minval=5, title="BB Length",               group="Whipsaw Filter")
bbw_avg_len = input.int(50, minval=10, title="BB Width 평균 기간",     group="Whipsaw Filter")
bbw_mult    = input.float(1.0, minval=0.1, step=0.1, title="BB Width 배수 (낮을수록 민감)", group="Whipsaw Filter")

bb_basis = ta.sma(close, bbw_len)
bb_dev   = 2.0 * ta.stdev(close, bbw_len)
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bbw      = (bb_upper - bb_lower) / bb_basis * 100  // BB 폭 (%)
bbw_avg  = ta.sma(bbw, bbw_avg_len)                // BB 폭 이동평균
not_squeeze = bbw > bbw_avg * bbw_mult              // 스퀴즈 아님 = 시그널 허용

// ① Pivot High / Low 감지
ph = ta.pivothigh(high, exit_pivot_left, exit_pivot_right)
pl = ta.pivotlow(low,   exit_pivot_left, exit_pivot_right)
found_pivot_high = not na(ph)
found_pivot_low  = not na(pl)

// ② RSI 과매수/과매도 (확정 봉 기준)
exit_rsi = ta.rsi(close, exit_rsi_len)
rsi_overbought = exit_rsi[1] > exit_rsi_ob
rsi_oversold   = exit_rsi[1] < exit_rsi_os

// ③ HMA 기울기 반전
hma_val = hullma(hma_src, hma_base_length + hma_length_scalar * 6)
hma_slope_down = hma_val[1] < hma_val[2]
hma_slope_up   = hma_val[1] > hma_val[2]

// 포지션 추적 (색상 변화 진입 + TP 반전)
var int position = 0     // 1=롱, -1=숏, 0=없음
var int last_signal = 0  // 마지막 시그널 방향: 1=롱, -1=숏

// 스코어 계산
exit_long_score  = (found_pivot_high ? 1 : 0) + (rsi_overbought ? 1 : 0) + (hma_slope_down ? 1 : 0)
exit_short_score = (found_pivot_low  ? 1 : 0) + (rsi_oversold   ? 1 : 0) + (hma_slope_up   ? 1 : 0)

// TP 반전 시그널: 스코어 충족 + 교대 + BB 스퀴즈 아닐 때만
rev_to_short = exit_long_score  >= exit_min_score and last_signal != -1 and not_squeeze and barstate.isconfirmed
rev_to_long  = exit_short_score >= exit_min_score and last_signal !=  1 and not_squeeze and barstate.isconfirmed

// 포지션 & 시그널 기록 갱신 (색상변화 진입 → TP 반전 순서)
if trend_to_long
    position    :=  1
    last_signal :=  1
if trend_to_short
    position    := -1
    last_signal := -1
if rev_to_short
    position    := -1
    last_signal := -1
if rev_to_long
    position    :=  1
    last_signal :=  1

// 시그널 표시
plotshape(rev_to_short, title="TP → Short", text="SHORT", style=shape.labeldown,
     location=location.abovebar, color=color.red, textcolor=color.white, size=size.normal)
plotshape(rev_to_long, title="TP → Long", text="LONG", style=shape.labelup,
     location=location.belowbar, color=color.green, textcolor=color.white, size=size.normal)

// Pivot 레벨 표시 (참고용)
plot(found_pivot_high ? ph : na, title="Pivot High", style=plot.style_cross,
     color=color.new(color.red, 30), linewidth=2, offset=-exit_pivot_right)
plot(found_pivot_low ? pl : na, title="Pivot Low", style=plot.style_cross,
     color=color.new(color.green, 30), linewidth=2, offset=-exit_pivot_right)

// 알림 — 색상 변화 진입
alertcondition(trend_to_long,  title="Color → Long",  message="KBGv3: COLOR → LONG (녹색 전환)")
alertcondition(trend_to_short, title="Color → Short", message="KBGv3: COLOR → SHORT (적색 전환)")

// 알림 — TP 반전
alertcondition(rev_to_short, title="TP → Short", message="KBGv3: TP REVERSE → SHORT (고점 반전)")
alertcondition(rev_to_long,  title="TP → Long",  message="KBGv3: TP REVERSE → LONG (저점 반전)")
