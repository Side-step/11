# Magic/Email account key (from reveal.magic.link/polymarket)
MAGIC_PRIVATE_KEY=0x...

# Proxy wallet address (from polymarket.com profile)
PROXY_WALLET_ADDRESS=0x...

# Builder credentials (after Builder program approval)
BUILDER_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=

# Polygon RPC
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# CLOB API credentials (auto-generated by py-clob-client)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operation mode: observe | small_live | five_min_entry | full
OPERATION_MODE=observe

# Initial capital override (optional, otherwise reads from wallet)
# INITIAL_CAPITAL=200
